@using Vjezba.Model.Models
@model IObjectDetailsPageViewModel

@{
    Layout = null;
    ViewData["Title"] = "Package Hub | Object Details";

    var normalizedType = (Model.ObjectType ?? string.Empty).Trim().ToLowerInvariant();
    var displayType = normalizedType switch
    {
        "statuslog" => "Status Log",
        "package" => "Package",
        "courier" => "Courier",
        "warehouse" => "Warehouse",
        "user" => "User",
        "delivery" => "Delivery",
        "address" => "Address",
        _ => "Object"
    };
    var referenceCode = $"{normalizedType.ToUpperInvariant()}-{Model.ObjectId:00000}";
    var selectedTypeForBack = normalizedType switch
    {
        "statuslog" => "delivery",
        "address" => "package",
        _ => string.IsNullOrWhiteSpace(normalizedType) ? "package" : normalizedType
    };
    var fallbackUrl = Url.Action("Index", "Home", new { selectedType = selectedTypeForBack }) ?? "/";
    var editUrl = Url.Action("Index", "Home", new
    {
        selectedType = selectedTypeForBack,
        editType = normalizedType,
        editId = Model.ObjectId
    }) ?? fallbackUrl;
    var requestedReturnUrl = Context.Request.Query["returnUrl"].ToString();
    var backUrl = !string.IsNullOrWhiteSpace(requestedReturnUrl) && Url.IsLocalUrl(requestedReturnUrl)
        ? requestedReturnUrl
        : fallbackUrl;
    var nestedReturnUrl = Context.Request.Path + Context.Request.QueryString;
    ViewData["NestedReturnUrl"] = nestedReturnUrl;

    var deleteControllers = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
    {
        ["package"] = "Packages",
        ["courier"] = "Couriers",
        ["warehouse"] = "Warehouses",
        ["user"] = "Users",
        ["delivery"] = "Deliveries",
        ["address"] = "Addresses",
        ["statuslog"] = "StatusLogs"
    };
    var deleteLabels = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
    {
        ["package"] = "package",
        ["courier"] = "courier",
        ["warehouse"] = "warehouse",
        ["user"] = "user",
        ["delivery"] = "delivery",
        ["address"] = "address",
        ["statuslog"] = "status log"
    };
    var deleteController = deleteControllers.TryGetValue(normalizedType, out var controller)
        ? controller
        : string.Empty;
    var deleteLabel = deleteLabels.TryGetValue(normalizedType, out var label)
        ? label
        : "item";
}

<!DOCTYPE html>
<html class="light" lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script>
        (function () {
            try {
                if (window.localStorage.getItem("analogSidebarCollapsed") === "1") {
                    document.documentElement.classList.add("analog-sidebar-collapsed");
                }
            } catch (e) {
            }
        })();
    </script>
    <script src="~/js/index-analog-log-tailwind-config.js" asp-append-version="true"></script>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@400;500;700&family=Work+Sans:wght@600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/index-analog-log.css" asp-append-version="true" />
    <script src="~/js/site.js" asp-append-version="true" defer></script>
</head>
<body class="analog-shell-bg font-body text-on-surface flex min-h-screen">
    <partial name="Partials/_AnalogSidebar" model="@(null as Vjezba.Model.Models.ObjectOverviewViewModel)" />

    <main class="index-canvas-bg flex-1 flex flex-col min-w-0 bg-surface relative overflow-hidden">
        <div class="absolute inset-0 grain-overlay"></div>

        <header class="w-full top-0 sticky z-20 flex justify-between items-center px-6 py-4 analog-topbar-surface">
            <div class="flex items-center gap-4">
                <a href="@backUrl" class="flex items-center gap-2 text-primary hover:text-[#653d1e] transition-colors">
                    <span class="material-symbols-outlined">arrow_back</span>
                    <span class="font-label text-xs uppercase tracking-widest">Back</span>
                </a>
                <nav class="hidden sm:flex items-center gap-2 text-[10px] font-label uppercase tracking-widest text-on-surface-variant">
                    <a href="@backUrl" class="hover:text-primary transition-colors">Previous</a>
                    <span>/</span>
                    <span class="text-on-surface">@referenceCode</span>
                </nav>
                <span class="sm:hidden font-headline font-bold text-lg uppercase tracking-widest text-on-surface">@referenceCode</span>
            </div>
            <div class="flex items-center gap-4">
                <button class="p-2 text-[#7d5231] hover:bg-[#e5e2df] rounded-full transition-colors" type="button">
                    <span class="material-symbols-outlined">notifications</span>
                </button>
                <button class="p-2 text-[#7d5231] hover:bg-[#e5e2df] rounded-full transition-colors" type="button">
                    <span class="material-symbols-outlined">settings</span>
                </button>
                <div class="w-8 h-8 rounded-full border border-outline-variant/20 bg-primary-container"></div>
            </div>
        </header>

        <div class="p-6 lg:p-8 max-w-7xl mx-auto w-full relative z-10">
            <section class="details-content-shell analog-panel-surface rounded-xl p-6">
                <div class="flex items-center justify-between mb-4">
                    <h4 class="font-headline text-2xl font-bold">@displayType Details</h4>
                    <div class="flex items-center gap-3">
                        @if (!string.IsNullOrWhiteSpace(deleteController))
                        {
                            <a href="@editUrl" class="inline-flex items-center gap-2 rounded px-3 py-2 text-[10px] font-label uppercase tracking-widest text-on-secondary-container bg-secondary-container hover:bg-secondary-container/80 transition-colors">
                                <span class="material-symbols-outlined text-[16px]">edit</span>
                                Edit @deleteLabel
                            </a>
                            <form asp-controller="@deleteController" asp-action="SoftDelete" asp-route-id="@Model.ObjectId" method="post">
                                <button type="submit" class="inline-flex items-center gap-2 rounded px-3 py-2 text-[10px] font-label uppercase tracking-widest text-error bg-error/10 hover:bg-error/20 transition-colors">
                                    <span class="material-symbols-outlined text-[16px]">delete</span>
                                    Delete @deleteLabel
                                </button>
                            </form>
                        }
                    </div>
                </div>

                <div class="overflow-x-auto analog-table-surface rounded-lg p-1">
                    @if (Model is PackageDetailsViewModel packageModel)
                    {
                        <partial name="Partials/Details/_PackageDetails" model="packageModel" />
                    }
                    else if (Model is CourierDetailsViewModel courierModel)
                    {
                        <partial name="Partials/Details/_CourierDetails" model="courierModel" />
                    }
                    else if (Model is UserDetailsViewModel userModel)
                    {
                        <partial name="Partials/Details/_UserDetails" model="userModel" />
                    }
                    else if (Model is WarehouseDetailsViewModel warehouseModel)
                    {
                        <partial name="Partials/Details/_WarehouseDetails" model="warehouseModel" />
                    }
                    else if (Model is DeliveryDetailsViewModel deliveryModel)
                    {
                        <partial name="Partials/Details/_DeliveryDetails" model="deliveryModel" />
                    }
                    else if (Model is AddressDetailsViewModel addressModel)
                    {
                        <partial name="Partials/Details/_AddressDetails" model="addressModel" />
                    }
                    else if (Model is StatusLogDetailsViewModel statusLogModel)
                    {
                        <partial name="Partials/Details/_StatusLogDetails" model="statusLogModel" />
                    }
                    else
                    {
                        <div class="px-4 py-3 text-sm text-on-surface-variant">
                            Unable to render this details view.
                        </div>
                    }
                </div>
            </section>
        </div>

        <nav class="md:hidden sticky bottom-0 w-full bg-surface-bright/90 backdrop-blur-xl flex justify-around items-center py-4 px-6 z-30">
            <a class="flex flex-col items-center gap-1 text-[#7d5231]" asp-action="Index">
                <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">package_2</span>
                <span class="text-[10px] font-label uppercase font-bold">Items</span>
            </a>
            <a class="flex flex-col items-center gap-1 text-stone-400" href="#">
                <span class="material-symbols-outlined">local_shipping</span>
                <span class="text-[10px] font-label uppercase">Fleet</span>
            </a>
            <div class="relative -top-6">
                <button class="w-14 h-14 bg-secondary-container text-on-secondary-container rounded-full shadow-lg flex items-center justify-center" type="button">
                    <span class="material-symbols-outlined">qr_code_scanner</span>
                </button>
            </div>
            <a class="flex flex-col items-center gap-1 text-stone-400" href="#">
                <span class="material-symbols-outlined">warehouse</span>
                <span class="text-[10px] font-label uppercase">Hubs</span>
            </a>
            <a class="flex flex-col items-center gap-1 text-stone-400" href="#">
                <span class="material-symbols-outlined">group</span>
                <span class="text-[10px] font-label uppercase">Staff</span>
            </a>
        </nav>
    </main>
</body>
</html>
