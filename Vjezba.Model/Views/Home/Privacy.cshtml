@{
    Layout = null;
    ViewData["Title"] = "Package Hub | Privacy Policy";
    var currentLang = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var backUrl = Url.Action("Index", "Home", new { selectedType = "package" }) ?? "/";
}

<!DOCTYPE html>
<html class="light" lang="@currentLang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script>
        (function () {
            try {
                if (window.localStorage.getItem("analogSidebarCollapsed") === "1") {
                    document.documentElement.classList.add("analog-sidebar-collapsed");
                }
            } catch (e) {
            }
        })();
    </script>
    <script src="~/js/index-analog-log-tailwind-config.js" asp-append-version="true"></script>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@400;500;700&family=Work+Sans:wght@600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/index-analog-log.css" asp-append-version="true" />
    <script src="~/js/site.js" asp-append-version="true" defer></script>
</head>
<body class="analog-shell-bg font-body text-on-surface flex min-h-screen">
    <partial name="Partials/_AnalogSidebar" model="@(null as Vjezba.Model.Models.ObjectOverviewViewModel)" />

    <main class="index-canvas-bg flex-1 flex flex-col min-w-0 bg-surface relative overflow-hidden">
        <div class="absolute inset-0 grain-overlay"></div>

        <div class="p-4 pt-16 sm:p-6 sm:pt-20 lg:p-8 max-w-5xl mx-auto w-full relative z-10">
            <section class="details-content-shell analog-panel-surface rounded-xl p-6 lg:p-8">
                <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-2 mb-6">
                    <div>
                        <p class="font-label text-[10px] uppercase tracking-widest text-on-surface-variant">Policy</p>
                        <h1 class="font-headline text-2xl md:text-3xl font-bold">Privacy Policy</h1>
                    </div>
                    <p class="font-label text-[10px] uppercase tracking-widest text-on-surface-variant">Updated May 21, 2026</p>
                </div>

                <div class="space-y-4 text-sm leading-6 text-on-surface-variant">
                    <p>
                        This application is used for educational and logistics management workflows.
                        Data is handled only for package lifecycle operations inside the dashboard.
                    </p>

                    <div class="analog-table-surface rounded-lg p-4">
                        <h2 class="font-headline text-lg font-bold text-on-surface mb-2">What We Store</h2>
                        <ul class="list-disc pl-5 space-y-1">
                            <li>Package and delivery metadata</li>
                            <li>User and courier contact information</li>
                            <li>Address and status history records</li>
                        </ul>
                    </div>

                    <div class="analog-table-surface rounded-lg p-4">
                        <h2 class="font-headline text-lg font-bold text-on-surface mb-2">How Data Is Used</h2>
                        <ul class="list-disc pl-5 space-y-1">
                            <li>Displaying manifests and object details</li>
                            <li>Supporting create, edit, search and soft-delete operations</li>
                            <li>Operational tracking and audit history</li>
                        </ul>
                    </div>

                    <p>
                        If you need correction or deletion of data, contact the system administrator.
                    </p>
                </div>
            </section>
        </div>
    </main>
</body>
</html>
