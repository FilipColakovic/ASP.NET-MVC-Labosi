@using System.Globalization
@using Vjezba.Model.Enums
@model Vjezba.Model.Models.ObjectOverviewViewModel

@{
    Layout = null;
    ViewData["Title"] = "Package Hub | Analytics";
    ViewData["SelectedType"] = "analytics";
    ViewData["TopbarActive"] = "analytics";
    ViewData["TopbarSearchPlaceholder"] = "Search package...";
    var currentLang = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;

    var nowUtc = DateTime.UtcNow;
    var weekStartUtc = nowUtc.Date.AddDays(-7);
    var previousWeekStartUtc = weekStartUtc.AddDays(-7);

    var weekThroughput = Model.Packages.Count(p => p.CreatedAt >= weekStartUtc);
    var previousWeekThroughput = Model.Packages.Count(p => p.CreatedAt >= previousWeekStartUtc && p.CreatedAt < weekStartUtc);
    var throughputDelta = previousWeekThroughput == 0
        ? (weekThroughput > 0 ? 100d : 0d)
        : ((double)(weekThroughput - previousWeekThroughput) / previousWeekThroughput) * 100d;

    var deliveryDurations = Model.Deliveries
        .Where(d => d.ArrivalDate > d.DepartureDate)
        .Select(d => (d.ArrivalDate - d.DepartureDate).TotalHours)
        .ToList();
    var averageDeliveryHours = deliveryDurations.Any() ? deliveryDurations.Average() : 0d;
    var delayedDeliveries = Model.Deliveries.Count(d => d.IsDelayed);

    var totalCouriers = Model.Couriers.Count;
    var availableCouriers = Model.Couriers.Count(c => c.IsAvailable);
    var fleetEfficiency = totalCouriers == 0 ? 0d : (double)availableCouriers / totalCouriers * 100d;
    var efficiencyStars = Math.Clamp((int)Math.Round(fleetEfficiency / 20d, MidpointRounding.AwayFromZero), 0, 5);

    List<(DateTime SlotStart, int Count)> BuildHourlyBuckets(DateTime firstHour)
    {
        return Enumerable.Range(0, 24)
            .Select(index =>
            {
                var slotStart = firstHour.AddHours(index);
                var slotEnd = slotStart.AddHours(1);
                var count = Model.Packages.Count(p => p.CreatedAt >= slotStart && p.CreatedAt < slotEnd);
                return (SlotStart: slotStart, Count: count);
            })
            .ToList();
    }

    var firstHourUtc = new DateTime(nowUtc.Year, nowUtc.Month, nowUtc.Day, nowUtc.Hour, 0, 0, DateTimeKind.Utc).AddHours(-23);
    var hourlyThroughput = BuildHourlyBuckets(firstHourUtc);
    var usesLatestDataWindow = false;
    if (!hourlyThroughput.Any(x => x.Count > 0) && Model.Packages.Any())
    {
        var latestPackageTimestamp = Model.Packages.Max(p => p.CreatedAt);
        var latestHourUtc = new DateTime(
            latestPackageTimestamp.Year,
            latestPackageTimestamp.Month,
            latestPackageTimestamp.Day,
            latestPackageTimestamp.Hour,
            0,
            0,
            DateTimeKind.Utc);
        hourlyThroughput = BuildHourlyBuckets(latestHourUtc.AddHours(-23));
        usesLatestDataWindow = true;
    }
    var maxHourlyValue = Math.Max(1, hourlyThroughput.Max(x => x.Count));
    var peakHourIndex = hourlyThroughput
        .Select((bucket, index) => new { bucket.Count, Index = index })
        .OrderByDescending(x => x.Count)
        .ThenBy(x => x.Index)
        .Select(x => x.Index)
        .FirstOrDefault();

    var regionalHubs = Model.Warehouses
        .GroupBy(w => string.IsNullOrWhiteSpace(w.Address?.Country) ? "Unassigned" : w.Address.Country.Trim())
        .Select(group =>
        {
            var capacity = group.Sum(x => Math.Max(0, x.Capacity));
            var used = group.Sum(x => x.StoredPackages?.Count ?? 0);
            var utilization = capacity == 0 ? 0 : (int)Math.Round(100d * used / capacity);
            return (
                Region: group.Key,
                Used: used,
                Capacity: capacity,
                Utilization: Math.Clamp(utilization, 0, 100)
            );
        })
        .OrderByDescending(x => x.Utilization)
        .ThenByDescending(x => x.Used)
        .Take(5)
        .ToList();
    if (!regionalHubs.Any())
    {
        regionalHubs = new List<(string Region, int Used, int Capacity, int Utilization)>
        {
            ("No hubs yet", 0, 0, 0)
        };
    }

    var totalPackages = Model.Packages.Count;
    var deliveredPackages = Model.Packages.Count(p => p.Status == PackageStatus.Delivered);
    var inTransitPackages = Model.Packages.Count(p => p.Status == PackageStatus.InTransit || p.Status == PackageStatus.OutForDelivery);
    var pendingPackages = Math.Max(0, totalPackages - deliveredPackages - inTransitPackages);
    var deliveredWeightKg = Model.Packages.Where(p => p.Status == PackageStatus.Delivered).Sum(p => (double)p.WeightKg);
    var carbonOffsetTons = deliveredWeightKg * 0.0018;

    var courierLoad = Model.Couriers
        .Select(c => new
        {
            Name = $"{c.FirstName} {c.LastName}".Trim(),
            AssignedPackages = Model.Packages.Count(p => p.CourierId == c.Id),
            IsAvailable = c.IsAvailable
        })
        .OrderByDescending(x => x.AssignedPackages)
        .ThenBy(x => x.Name)
        .Take(4)
        .ToList();
}

<!DOCTYPE html>
<html class="light" lang="@currentLang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script>
        (function () {
            try {
                if (window.localStorage.getItem("analogSidebarCollapsed") === "1") {
                    document.documentElement.classList.add("analog-sidebar-collapsed");
                }
            } catch (e) {
            }
        })();
    </script>
    <script src="~/js/index-analog-log-tailwind-config.js" asp-append-version="true"></script>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;600;700;900&family=Inter:wght@400;500;600&family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/index-analog-log.css" asp-append-version="true" />
    <script src="~/js/site.js" asp-append-version="true" defer></script>
</head>
<body class="analog-shell-bg font-body text-on-surface flex min-h-screen">
    <partial name="Partials/_AnalogSidebar" model="Model" />

    <main class="index-canvas-bg flex-1 flex flex-col min-w-0 relative overflow-hidden">
        <div class="absolute inset-0 grain-overlay"></div>

        <partial name="Partials/_AnalogTopbar" />

        <div class="relative z-10 p-4 md:p-8 max-w-7xl mx-auto w-full space-y-6 md:space-y-8 overflow-y-auto">
            <section class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-4">
                <div>
                    <h1 class="font-headline text-3xl md:text-4xl font-black tracking-tight text-on-surface">Performance Analytics</h1>
                    <p class="font-label text-xs uppercase tracking-widest text-on-surface-variant mt-2">Real-time logistics metadata and efficiency reporting</p>
                </div>
                <div class="flex flex-wrap items-center gap-3">
                    <div class="stamp-effect bg-tertiary/10 text-tertiary px-4 py-1 border border-tertiary/25 rounded-md font-label text-[10px] uppercase tracking-widest font-bold flex items-center gap-2">
                        <span class="h-1.5 w-1.5 rounded-full bg-tertiary animate-pulse"></span>
                        Verified stream
                    </div>
                    <button class="bg-secondary-container text-on-secondary-container px-4 py-2 rounded-md font-label text-[10px] uppercase tracking-widest font-bold shadow-sm hover:brightness-110 transition-all" type="button">
                        Export Report
                    </button>
                </div>
            </section>

            <section class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6">
                <article class="analog-panel-surface rounded-xl p-5 md:p-6 relative overflow-hidden group" data-analytics-lift>
                    <p class="font-label text-[10px] uppercase tracking-widest text-on-surface-variant mb-4 flex items-center gap-2">
                        <span class="material-symbols-outlined text-base">inventory</span>
                        Weekly Throughput
                    </p>
                    <div class="flex items-baseline gap-2 mb-3">
                        <span class="font-headline text-4xl font-black tracking-tight">@weekThroughput.ToString("N0", CultureInfo.InvariantCulture)</span>
                        <span class="font-label text-xs font-bold @(throughputDelta >= 0 ? "text-tertiary" : "text-error")">
                            @throughputDelta.ToString("+0.0;-0.0;0.0", CultureInfo.InvariantCulture)%
                        </span>
                    </div>
                    <div class="w-full h-2 rounded-full bg-primary-fixed-dim/30">
                        <div class="h-2 rounded-full bg-primary" style="width:@Math.Clamp((int)Math.Round(Math.Abs(throughputDelta)), 15, 100)%"></div>
                    </div>
                    <div class="absolute -right-4 -bottom-4 opacity-10">
                        <span class="material-symbols-outlined text-8xl">package</span>
                    </div>
                </article>

                <article class="analog-panel-surface rounded-xl p-5 md:p-6 border-l-4 border-secondary-container" data-analytics-lift>
                    <p class="font-label text-[10px] uppercase tracking-widest text-on-surface-variant mb-4">Average Delivery Time</p>
                    <div class="flex items-baseline gap-2 mb-3">
                        <span class="font-headline text-4xl font-black tracking-tight">@averageDeliveryHours.ToString("0.0", CultureInfo.InvariantCulture) <span class="text-lg font-semibold text-on-surface-variant/50">hrs</span></span>
                        <span class="font-label text-xs font-bold @(delayedDeliveries > 0 ? "text-error" : "text-tertiary")">@delayedDeliveries delayed</span>
                    </div>
                    <div class="grid grid-cols-7 gap-1 h-8 items-end">
                        <div class="bg-primary/20 h-2 rounded-sm"></div>
                        <div class="bg-primary/30 h-4 rounded-sm"></div>
                        <div class="bg-primary/40 h-3 rounded-sm"></div>
                        <div class="bg-primary/50 h-6 rounded-sm"></div>
                        <div class="bg-primary/60 h-5 rounded-sm"></div>
                        <div class="bg-primary/80 h-7 rounded-sm"></div>
                        <div class="bg-secondary-container h-8 rounded-sm"></div>
                    </div>
                </article>

                <article class="analog-panel-surface rounded-xl p-5 md:p-6" data-analytics-lift>
                    <p class="font-label text-[10px] uppercase tracking-widest text-on-surface-variant mb-4 flex justify-between">
                        Fleet Efficiency
                        <span class="font-bold text-primary">@fleetEfficiency.ToString("0.0", CultureInfo.InvariantCulture)%</span>
                    </p>
                    <div class="relative h-24 flex items-center justify-center">
                        <svg class="h-full w-full -rotate-90" viewBox="0 0 36 36" role="img" aria-label="Fleet efficiency">
                            <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="#d4c4b7" stroke-width="3"></path>
                            <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="#7a4c2b" stroke-dasharray="@fleetEfficiency.ToString("0.0", CultureInfo.InvariantCulture), 100" stroke-width="3"></path>
                        </svg>
                        <div class="absolute text-center">
                            <span class="material-symbols-outlined text-primary">local_shipping</span>
                        </div>
                    </div>
                </article>
            </section>

            <section class="grid grid-cols-1 xl:grid-cols-3 gap-6">
                <article class="xl:col-span-2 analog-panel-surface rounded-xl p-5 md:p-8 min-h-[420px] flex flex-col">
                    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
                        <div>
                            <h2 class="font-headline text-2xl font-bold tracking-tight">Package Volume Trend</h2>
                            <p class="font-label text-[10px] uppercase tracking-widest text-on-surface-variant/70">
                                @(usesLatestDataWindow
                                    ? "Aggregate hourly throughput (latest 24h in dataset)"
                                    : "Aggregate hourly throughput (last 24 hours)")
                            </p>
                        </div>
                        <div class="flex gap-2">
                            <button class="px-3 py-1 bg-surface-container-lowest border border-outline-variant/25 rounded-sm font-label text-[10px] uppercase tracking-widest font-bold" type="button">Day</button>
                            <button class="px-3 py-1 rounded-sm font-label text-[10px] uppercase tracking-widest opacity-50" type="button">Week</button>
                            <button class="px-3 py-1 rounded-sm font-label text-[10px] uppercase tracking-widest opacity-50" type="button">Month</button>
                        </div>
                    </div>

                    <div class="relative h-72 md:h-80 flex items-end gap-[2px] pt-10">
                        <div class="absolute inset-0 flex flex-col justify-between py-10 opacity-10 pointer-events-none">
                            <div class="w-full border-t border-on-surface"></div>
                            <div class="w-full border-t border-on-surface"></div>
                            <div class="w-full border-t border-on-surface"></div>
                            <div class="w-full border-t border-on-surface"></div>
                        </div>

                        @for (var index = 0; index < hourlyThroughput.Count; index++)
                        {
                            var bucket = hourlyThroughput[index];
                            var maxBarHeightPx = 240;
                            var heightPx = bucket.Count == 0
                                ? 4
                                : Math.Max(16, (int)Math.Round((double)bucket.Count / maxHourlyValue * maxBarHeightPx));
                            var isPeak = index == peakHourIndex;
                            var localHour = bucket.SlotStart.ToLocalTime().ToString("HH:mm", CultureInfo.InvariantCulture);
                            var barClass = isPeak ? "bg-secondary-container" : "bg-primary/30 hover:bg-primary/45";
                            <div class="flex-1 rounded-t-sm transition-colors @barClass"
                                 style="height:@(heightPx)px"
                                 title="@localHour - @bucket.Count packages">
                                @if (isPeak)
                                {
                                    <div class="w-2 h-2 bg-on-surface rounded-full -mt-1 mx-auto"></div>
                                }
                            </div>
                        }
                    </div>

                    <div class="flex justify-between mt-4 font-label text-[9px] uppercase tracking-widest text-on-surface-variant/45">
                        <span>@hourlyThroughput.First().SlotStart.ToLocalTime().ToString("HH:mm", CultureInfo.InvariantCulture)</span>
                        <span>@hourlyThroughput[6].SlotStart.ToLocalTime().ToString("HH:mm", CultureInfo.InvariantCulture)</span>
                        <span>@hourlyThroughput[12].SlotStart.ToLocalTime().ToString("HH:mm", CultureInfo.InvariantCulture)</span>
                        <span>@hourlyThroughput[18].SlotStart.ToLocalTime().ToString("HH:mm", CultureInfo.InvariantCulture)</span>
                        <span>@hourlyThroughput.Last().SlotStart.ToLocalTime().ToString("HH:mm", CultureInfo.InvariantCulture)</span>
                    </div>
                </article>

                <article class="analog-panel-surface rounded-xl p-5 md:p-8">
                    <h2 class="font-headline text-2xl font-bold tracking-tight mb-2">Regional Hubs</h2>
                    <p class="font-label text-[10px] uppercase tracking-widest text-on-surface-variant/70 mb-8">Capacity utilization by zone</p>
                    <div class="space-y-5">
                        @foreach (var hub in regionalHubs)
                        {
                            <div>
                                <div class="flex justify-between items-center mb-2 font-label text-[11px] uppercase tracking-widest font-bold">
                                    <span>@hub.Region</span>
                                    <span class="@(hub.Utilization >= 90 ? "text-secondary-container" : "text-primary")">@hub.Utilization%</span>
                                </div>
                                <div class="w-full h-1.5 bg-surface-container overflow-hidden rounded-full">
                                    <div class="h-full @(hub.Utilization >= 90 ? "bg-secondary-container" : "bg-primary")" style="width:@hub.Utilization%"></div>
                                </div>
                                <p class="mt-1 font-label text-[9px] uppercase tracking-widest text-on-surface-variant/55">@hub.Used / @(hub.Capacity == 0 ? 1 : hub.Capacity) slots used</p>
                            </div>
                        }
                    </div>

                    <div class="mt-10 p-4 rounded-lg border-2 border-dashed border-outline-variant/40 bg-surface-container-low text-center">
                        <span class="material-symbols-outlined text-5xl text-primary/45">hub</span>
                        <p class="mt-3 font-label text-[10px] uppercase tracking-widest text-on-surface-variant leading-relaxed">
                            Peak hour observed at
                            <span class="text-secondary font-bold">@hourlyThroughput[peakHourIndex].SlotStart.ToLocalTime().ToString("HH:mm", CultureInfo.InvariantCulture)</span>
                            with
                            <span class="text-secondary font-bold">@hourlyThroughput[peakHourIndex].Count</span>
                            package events.
                        </p>
                    </div>
                </article>
            </section>

            <section class="grid grid-cols-1 lg:grid-cols-4 gap-6">
                <article class="lg:col-span-1 rounded-xl p-6 border border-primary/15 bg-primary/5">
                    <div class="text-primary mb-4">
                        <span class="material-symbols-outlined text-4xl" style="font-variation-settings: 'FILL' 1;">eco</span>
                    </div>
                    <h3 class="font-headline text-xl font-bold">Carbon Offset</h3>
                    <p class="font-label text-xs uppercase tracking-widest text-on-surface-variant/75 mt-1 mb-4">Estimated from delivered weight</p>
                    <p class="font-headline text-3xl font-black text-primary">@carbonOffsetTons.ToString("0.00", CultureInfo.InvariantCulture) <span class="text-sm font-semibold">tons</span></p>
                </article>

                <article class="lg:col-span-3 analog-panel-surface rounded-xl p-6 flex flex-col xl:flex-row xl:items-center xl:justify-between gap-6">
                    <div class="flex flex-wrap gap-8">
                        <div>
                            <p class="font-label text-[10px] uppercase tracking-widest text-on-surface-variant mb-3">Live Package Status</p>
                            <div class="flex items-center gap-5">
                                <div class="text-center">
                                    <p class="font-headline text-3xl font-black">@inTransitPackages</p>
                                    <p class="font-label text-[9px] uppercase tracking-widest text-on-surface-variant/60">Transit</p>
                                </div>
                                <div class="w-px h-9 bg-outline-variant/40"></div>
                                <div class="text-center">
                                    <p class="font-headline text-3xl font-black">@pendingPackages</p>
                                    <p class="font-label text-[9px] uppercase tracking-widest text-on-surface-variant/60">Pending</p>
                                </div>
                                <div class="w-px h-9 bg-outline-variant/40"></div>
                                <div class="text-center">
                                    <p class="font-headline text-3xl font-black">@deliveredPackages</p>
                                    <p class="font-label text-[9px] uppercase tracking-widest text-tertiary font-bold">Delivered</p>
                                </div>
                            </div>
                        </div>

                        <div>
                            <p class="font-label text-[10px] uppercase tracking-widest text-on-surface-variant mb-3">Efficiency Rating</p>
                            <div class="flex gap-1">
                                @for (var starIndex = 0; starIndex < 5; starIndex++)
                                {
                                    var fill = starIndex < efficiencyStars ? 1 : 0;
                                    <span class="material-symbols-outlined text-tertiary text-sm" style="font-variation-settings: 'FILL' @fill;">star</span>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="flex -space-x-3">
                        @if (courierLoad.Any())
                        {
                            @foreach (var courier in courierLoad)
                            {
                                var initials = new string(courier.Name
                                    .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                                    .Take(2)
                                    .Select(part => char.ToUpperInvariant(part[0]))
                                    .ToArray());
                                <div class="h-10 w-10 rounded-full border-2 border-surface-container-low ring-2 ring-primary/10 bg-surface-container-high flex items-center justify-center font-label text-[10px] font-bold text-primary"
                                     title="@courier.Name - @courier.AssignedPackages packages">
                                    @initials
                                </div>
                            }
                        }
                        else
                        {
                            <div class="h-10 w-10 rounded-full border-2 border-surface-container-low bg-surface-container-high flex items-center justify-center font-label text-[10px] font-bold text-primary">0</div>
                        }
                        <div class="h-10 w-10 rounded-full bg-surface-container-highest border-2 border-surface-container-low flex items-center justify-center text-[10px] font-bold font-label"
                             title="Available couriers">
                            +@availableCouriers
                        </div>
                    </div>
                </article>
            </section>
        </div>
    </main>

    <script>
        (() => {
            const cards = document.querySelectorAll("[data-analytics-lift]");
            cards.forEach((card) => {
                card.addEventListener("mouseenter", () => {
                    card.style.transform = "translateY(-2px)";
                    card.style.transition = "transform 0.2s ease-out";
                });
                card.addEventListener("mouseleave", () => {
                    card.style.transform = "translateY(0)";
                });
            });
        })();
    </script>
</body>
</html>
