@model Vjezba.Model.Models.UserDetailsViewModel

@{
    var user = Model.User;
}

<table class="w-full text-left border-collapse min-w-[720px] rounded-md overflow-hidden">
    <thead>
        <tr class="bg-surface-container-high font-label text-[10px] text-on-surface-variant uppercase tracking-widest">
            <th class="px-4 py-3 font-bold">Field</th>
            <th class="px-4 py-3 font-bold">Value</th>
        </tr>
    </thead>
    <tbody class="font-body text-sm divide-y divide-surface-container-high/30">
        <tr class="hover:bg-surface-container-low transition-colors">
            <td class="px-4 py-3 font-label text-[11px] uppercase tracking-wider text-on-surface-variant">Name</td>
            <td class="px-4 py-3">@user.FirstName @user.LastName</td>
        </tr>
        <tr class="hover:bg-surface-container-low transition-colors">
            <td class="px-4 py-3 font-label text-[11px] uppercase tracking-wider text-on-surface-variant">Email</td>
            <td class="px-4 py-3">@user.Email</td>
        </tr>
        <tr class="hover:bg-surface-container-low transition-colors">
            <td class="px-4 py-3 font-label text-[11px] uppercase tracking-wider text-on-surface-variant">Phone</td>
            <td class="px-4 py-3">@user.PhoneNumber</td>
        </tr>
        <tr class="hover:bg-surface-container-low transition-colors">
            <td class="px-4 py-3 font-label text-[11px] uppercase tracking-wider text-on-surface-variant">Registered</td>
            <td class="px-4 py-3">@user.RegistrationDate.ToString("yyyy.MM.dd HH:mm")</td>
        </tr>
        <tr class="hover:bg-surface-container-low transition-colors">
            <td class="px-4 py-3 font-label text-[11px] uppercase tracking-wider text-on-surface-variant">Sent packages</td>
            <td class="px-4 py-3">@Model.SentPackageCount</td>
        </tr>
        <tr class="hover:bg-surface-container-low transition-colors">
            <td class="px-4 py-3 font-label text-[11px] uppercase tracking-wider text-on-surface-variant">Received packages</td>
            <td class="px-4 py-3">@Model.ReceivedPackageCount</td>
        </tr>
    </tbody>
</table>
