@model Vjezba.Model.Models.PackageDetailsViewModel

@{
    var nestedReturnUrl = ViewData["NestedReturnUrl"]?.ToString() ?? "/";
    var package = Model.Package;
    var canUploadAttachments = User.IsInRole("Admin") || User.IsInRole("Manager");
    var canDeleteAttachments = User.IsInRole("Admin");
}

<table class="w-full text-left border-collapse min-w-[720px] rounded-md overflow-hidden">
    <thead>
        <tr class="bg-surface-container-high font-label text-[10px] text-on-surface-variant uppercase tracking-widest">
            <th class="px-4 py-3 font-bold">Field</th>
            <th class="px-4 py-3 font-bold">Value</th>
        </tr>
    </thead>
    <tbody class="font-body text-sm divide-y divide-surface-container-high/30">
        <tr class="hover:bg-surface-container-low transition-colors">
            <td class="px-4 py-3 font-label text-[11px] uppercase tracking-wider text-on-surface-variant">Tracking number</td>
            <td class="px-4 py-3">@package.TrackingNumber</td>
        </tr>
        <tr class="hover:bg-surface-container-low transition-colors">
            <td class="px-4 py-3 font-label text-[11px] uppercase tracking-wider text-on-surface-variant">Status</td>
            <td class="px-4 py-3">@package.Status</td>
        </tr>
        <tr class="hover:bg-surface-container-low transition-colors">
            <td class="px-4 py-3 font-label text-[11px] uppercase tracking-wider text-on-surface-variant">Priority</td>
            <td class="px-4 py-3">@package.DeliveryPriority</td>
        </tr>
        <tr class="hover:bg-surface-container-low transition-colors">
            <td class="px-4 py-3 font-label text-[11px] uppercase tracking-wider text-on-surface-variant">Weight (kg)</td>
            <td class="px-4 py-3">@package.WeightKg</td>
        </tr>
        <tr class="hover:bg-surface-container-low transition-colors">
            <td class="px-4 py-3 font-label text-[11px] uppercase tracking-wider text-on-surface-variant">Description</td>
            <td class="px-4 py-3">@package.Description</td>
        </tr>
        <tr class="hover:bg-surface-container-low transition-colors">
            <td class="px-4 py-3 font-label text-[11px] uppercase tracking-wider text-on-surface-variant">Created at</td>
            <td class="px-4 py-3">@package.CreatedAt.ToString("yyyy.MM.dd HH:mm")</td>
        </tr>
        <tr class="hover:bg-surface-container-low transition-colors">
            <td class="px-4 py-3 font-label text-[11px] uppercase tracking-wider text-on-surface-variant">Delivered at</td>
            <td class="px-4 py-3">@(package.DeliveredAt.HasValue ? package.DeliveredAt.Value.ToString("yyyy.MM.dd HH:mm") : "-")</td>
        </tr>
        <tr class="hover:bg-surface-container-low transition-colors">
            <td class="px-4 py-3 font-label text-[11px] uppercase tracking-wider text-on-surface-variant">Courier</td>
            <td class="px-4 py-3">
                <a asp-action="Details" asp-route-type="courier" asp-route-id="@package.CourierId" asp-route-returnUrl="@nestedReturnUrl" class="text-primary hover:text-[#653d1e] underline underline-offset-2 transition-colors">
                    @package.Courier.FirstName @package.Courier.LastName
                </a>
            </td>
        </tr>
        <tr class="hover:bg-surface-container-low transition-colors">
            <td class="px-4 py-3 font-label text-[11px] uppercase tracking-wider text-on-surface-variant">Sender</td>
            <td class="px-4 py-3">
                <a asp-action="Details" asp-route-type="user" asp-route-id="@package.SenderUserId" asp-route-returnUrl="@nestedReturnUrl" class="text-primary hover:text-[#653d1e] underline underline-offset-2 transition-colors">
                    @package.SenderUser.FirstName @package.SenderUser.LastName
                </a>
            </td>
        </tr>
        <tr class="hover:bg-surface-container-low transition-colors">
            <td class="px-4 py-3 font-label text-[11px] uppercase tracking-wider text-on-surface-variant">Recipient</td>
            <td class="px-4 py-3">
                <a asp-action="Details" asp-route-type="user" asp-route-id="@package.RecipientUserId" asp-route-returnUrl="@nestedReturnUrl" class="text-primary hover:text-[#653d1e] underline underline-offset-2 transition-colors">
                    @package.RecipientUser.FirstName @package.RecipientUser.LastName
                </a>
            </td>
        </tr>
        <tr class="hover:bg-surface-container-low transition-colors">
            <td class="px-4 py-3 font-label text-[11px] uppercase tracking-wider text-on-surface-variant">Sender address</td>
            <td class="px-4 py-3">
                <a asp-action="Details" asp-route-type="address" asp-route-id="@package.SenderAddressId" asp-route-returnUrl="@nestedReturnUrl" class="text-primary hover:text-[#653d1e] underline underline-offset-2 transition-colors">
                    @package.SenderAddress.Street, @package.SenderAddress.City
                </a>
            </td>
        </tr>
        <tr class="hover:bg-surface-container-low transition-colors">
            <td class="px-4 py-3 font-label text-[11px] uppercase tracking-wider text-on-surface-variant">Recipient address</td>
            <td class="px-4 py-3">
                <a asp-action="Details" asp-route-type="address" asp-route-id="@package.RecipientAddressId" asp-route-returnUrl="@nestedReturnUrl" class="text-primary hover:text-[#653d1e] underline underline-offset-2 transition-colors">
                    @package.RecipientAddress.Street, @package.RecipientAddress.City
                </a>
            </td>
        </tr>
        <tr class="hover:bg-surface-container-low transition-colors">
            <td class="px-4 py-3 font-label text-[11px] uppercase tracking-wider text-on-surface-variant">Status updates</td>
            <td class="px-4 py-3">@Model.StatusLogCount</td>
        </tr>
        <tr class="hover:bg-surface-container-low transition-colors">
            <td class="px-4 py-3 font-label text-[11px] uppercase tracking-wider text-on-surface-variant">Warehouses</td>
            <td class="px-4 py-3">@Model.WarehouseCount</td>
        </tr>
        <tr class="hover:bg-surface-container-low transition-colors">
            <td class="px-4 py-3 font-label text-[11px] uppercase tracking-wider text-on-surface-variant">Deliveries</td>
            <td class="px-4 py-3">@Model.DeliveryCount</td>
        </tr>
    </tbody>
</table>

<section class="mt-5 rounded-lg border border-outline-variant/20 bg-surface-container-low/70 p-4"
         data-package-attachments
         data-package-id="@package.Id"
         data-can-delete="@canDeleteAttachments.ToString().ToLowerInvariant()">
    <div class="flex flex-col gap-3 border-b border-outline-variant/20 pb-4 md:flex-row md:items-center md:justify-between">
        <div>
            <p class="font-label text-[10px] uppercase tracking-widest text-on-surface-variant">Package Attachments</p>
            <h5 class="font-headline text-lg font-bold text-on-surface">Files</h5>
        </div>

        @if (canUploadAttachments)
        {
            <form class="flex flex-col gap-2 sm:flex-row sm:items-center"
                  action="/packages/@package.Id/attachments"
                  method="post"
                  enctype="multipart/form-data"
                  data-attachment-upload>
                @Html.AntiForgeryToken()
                <label class="sr-only" for="package-attachment-file-@package.Id">Upload package attachment</label>
                <input id="package-attachment-file-@package.Id"
                       name="file"
                       type="file"
                       class="max-w-full rounded border border-outline-variant/30 bg-white/80 px-3 py-2 text-xs text-on-surface file:mr-3 file:rounded file:border-0 file:bg-secondary-container file:px-3 file:py-1.5 file:font-label file:text-[10px] file:font-bold file:uppercase file:tracking-widest file:text-on-secondary-container" />
                <button type="submit"
                        class="inline-flex items-center justify-center gap-2 rounded bg-secondary-container px-4 py-2 font-label text-[10px] uppercase tracking-widest text-on-secondary-container transition-colors hover:bg-secondary-container/80">
                    <span class="material-symbols-outlined text-[16px]">upload_file</span>
                    Upload
                </button>
            </form>
        }
    </div>

    <p class="field-error mt-3" data-attachment-summary></p>

    <div class="mt-3 grid gap-2" data-attachment-list>
        <div class="rounded border border-dashed border-outline-variant/40 bg-white/40 px-4 py-5 text-center font-label text-xs uppercase tracking-widest text-on-surface-variant">
            Loading attachments...
        </div>
    </div>
</section>

<script>
    (() => {
        const roots = document.querySelectorAll("[data-package-attachments]");
        if (!roots.length) {
            return;
        }

        const formatSize = (bytes) => {
            if (!Number.isFinite(bytes) || bytes <= 0) {
                return "0 B";
            }

            const units = ["B", "KB", "MB", "GB"];
            let value = bytes;
            let unitIndex = 0;
            while (value >= 1024 && unitIndex < units.length - 1) {
                value /= 1024;
                unitIndex++;
            }

            return `${value.toFixed(unitIndex === 0 ? 0 : 1)} ${units[unitIndex]}`;
        };

        roots.forEach((root) => {
            if (root.dataset.attachmentsInit === "1") {
                return;
            }

            root.dataset.attachmentsInit = "1";
            const packageId = root.dataset.packageId;
            const canDelete = root.dataset.canDelete === "true";
            const uploadForm = root.querySelector("[data-attachment-upload]");
            const list = root.querySelector("[data-attachment-list]");
            const summary = root.querySelector("[data-attachment-summary]");

            const setSummary = (message) => {
                if (summary) {
                    summary.textContent = message || "";
                }
            };

            const getToken = () =>
                root.querySelector('input[name="__RequestVerificationToken"]')?.value || "";

            const renderEmpty = () => {
                list.innerHTML = "";
                const empty = document.createElement("div");
                empty.className = "rounded border border-dashed border-outline-variant/40 bg-white/40 px-4 py-5 text-center font-label text-xs uppercase tracking-widest text-on-surface-variant";
                empty.textContent = "No attachments yet.";
                list.appendChild(empty);
            };

            const renderAttachments = (attachments) => {
                list.innerHTML = "";
                if (!attachments.length) {
                    renderEmpty();
                    return;
                }

                attachments.forEach((attachment) => {
                    const row = document.createElement("div");
                    row.className = "flex flex-col gap-3 rounded border border-outline-variant/20 bg-white/70 px-4 py-3 sm:flex-row sm:items-center sm:justify-between";

                    const details = document.createElement("div");
                    details.className = "min-w-0";

                    const link = document.createElement("a");
                    link.href = attachment.url;
                    link.target = "_blank";
                    link.rel = "noopener";
                    link.className = "block truncate font-body text-sm font-semibold text-primary underline-offset-2 hover:underline";
                    link.textContent = attachment.fileName;

                    const metadata = document.createElement("p");
                    metadata.className = "mt-1 font-label text-[10px] uppercase tracking-widest text-on-surface-variant";
                    metadata.textContent = `${formatSize(Number(attachment.fileSize))} / ${attachment.contentType || "file"}`;

                    details.appendChild(link);
                    details.appendChild(metadata);
                    row.appendChild(details);

                    if (canDelete) {
                        const deleteButton = document.createElement("button");
                        deleteButton.type = "button";
                        deleteButton.className = "inline-flex items-center justify-center gap-2 rounded px-3 py-2 font-label text-[10px] uppercase tracking-widest text-error transition-colors hover:bg-error/10";
                        deleteButton.dataset.attachmentDelete = attachment.id;
                        deleteButton.innerHTML = '<span class="material-symbols-outlined text-[16px]">delete</span> Delete';
                        row.appendChild(deleteButton);
                    }

                    list.appendChild(row);
                });
            };

            const loadAttachments = async () => {
                try {
                    const response = await fetch(`/packages/${packageId}/attachments`, {
                        headers: { "X-Requested-With": "XMLHttpRequest" }
                    });
                    if (!response.ok) {
                        throw new Error("Unable to load attachments.");
                    }

                    renderAttachments(await response.json());
                } catch (error) {
                    list.innerHTML = "";
                    const errorRow = document.createElement("div");
                    errorRow.className = "rounded border border-error/20 bg-error/5 px-4 py-3 text-sm text-error";
                    errorRow.textContent = "Unable to load attachments.";
                    list.appendChild(errorRow);
                }
            };

            if (uploadForm) {
                uploadForm.addEventListener("submit", async (event) => {
                    event.preventDefault();
                    setSummary("");

                    const fileInput = uploadForm.querySelector('input[type="file"]');
                    if (!fileInput || !fileInput.files.length) {
                        setSummary("Choose a file before uploading.");
                        return;
                    }

                    try {
                        const response = await fetch(uploadForm.action, {
                            method: "POST",
                            body: new FormData(uploadForm),
                            headers: { "X-Requested-With": "XMLHttpRequest" }
                        });

                        if (!response.ok) {
                            const payload = await response.json().catch(() => null);
                            throw new Error(payload?.message || "Unable to upload attachment.");
                        }

                        uploadForm.reset();
                        await loadAttachments();
                    } catch (error) {
                        setSummary(error.message || "Unable to upload attachment.");
                    }
                });
            }

            list.addEventListener("click", async (event) => {
                const button = event.target.closest("[data-attachment-delete]");
                if (!button) {
                    return;
                }

                setSummary("");
                try {
                    const response = await fetch(`/packages/${packageId}/attachments/${button.dataset.attachmentDelete}`, {
                        method: "DELETE",
                        headers: {
                            "RequestVerificationToken": getToken(),
                            "X-Requested-With": "XMLHttpRequest"
                        }
                    });

                    if (!response.ok) {
                        throw new Error("Unable to delete attachment.");
                    }

                    await loadAttachments();
                } catch (error) {
                    setSummary(error.message || "Unable to delete attachment.");
                }
            });

            loadAttachments();
        });
    })();
</script>
