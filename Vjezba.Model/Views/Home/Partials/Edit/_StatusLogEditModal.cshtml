@model Vjezba.Model.Models.StatusLogEditViewModel
@using Vjezba.Model.Enums
@using Vjezba.Model.Models

@{
    var overview = ViewData["Overview"] as ObjectOverviewViewModel;
    var packages = overview?.Packages ?? new List<Package>();
}

<div class="analog-modal is-hidden" data-edit-modal="statuslog" aria-hidden="true" aria-labelledby="statuslog-edit-title" role="dialog">
    <div class="analog-modal-backdrop" data-edit-close></div>
    <div class="analog-modal-panel analog-panel-surface">
        <div class="flex items-center justify-between border-b border-outline-variant/20 pb-3 mb-4">
            <div>
                <p class="font-label text-[10px] uppercase tracking-widest text-on-surface-variant">Status Log Update</p>
                <h3 id="statuslog-edit-title" class="font-headline text-xl font-bold">Edit status log</h3>
            </div>
            <button type="button" class="rounded-full p-2 text-on-surface-variant hover:bg-surface-container-high/70" data-edit-close aria-label="Close">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>

        <form asp-controller="StatusLogs" asp-action="Edit" method="post" data-edit-form novalidate>
            @Html.AntiForgeryToken()
            <input asp-for="Id" type="hidden" />

            <div class="space-y-4">
                <div class="grid gap-2">
                    <label asp-for="PackageId" class="font-label text-[10px] uppercase tracking-widest text-on-surface-variant">Package</label>
                    <select asp-for="PackageId" class="analog-input" data-autocomplete-source="packages" data-autocomplete-placeholder="Search package..." data-autocomplete-empty-label="Select package">
                        <option value="">Select package</option>
                        @foreach (var package in packages)
                        {
                            <option value="@package.Id">@package.TrackingNumber</option>
                        }
                    </select>
                    <span asp-validation-for="PackageId" class="field-error"></span>
                </div>

                <partial name="~/Views/Home/Partials/_DateTimePickerField.cshtml"
                         model='(Model.TimeChanged == default ? string.Empty : Model.TimeChanged.ToString("yyyy-MM-ddTHH:mm"))'
                         view-data='new ViewDataDictionary(ViewData)
                         {
                             ["FieldName"] = nameof(Model.TimeChanged),
                             ["Label"] = "Time changed",
                             ["RequiredMessage"] = "Time changed is required."
                         }' />

                <div class="grid gap-2">
                    <label asp-for="Location" class="font-label text-[10px] uppercase tracking-widest text-on-surface-variant"></label>
                    <input asp-for="Location" class="analog-input" />
                    <span asp-validation-for="Location" class="field-error"></span>
                </div>

                <div class="grid gap-2">
                    <label asp-for="Description" class="font-label text-[10px] uppercase tracking-widest text-on-surface-variant"></label>
                    <textarea asp-for="Description" class="analog-input" rows="3"></textarea>
                    <span asp-validation-for="Description" class="field-error"></span>
                </div>

                <div class="grid gap-2">
                    <label asp-for="PreviousStatus" class="font-label text-[10px] uppercase tracking-widest text-on-surface-variant">Previous status</label>
                    <select asp-for="PreviousStatus" class="analog-input">
                        @foreach (PackageStatus status in Enum.GetValues(typeof(PackageStatus)))
                        {
                            <option value="@status">@status</option>
                        }
                    </select>
                </div>

                <div class="grid gap-2">
                    <label asp-for="NewStatus" class="font-label text-[10px] uppercase tracking-widest text-on-surface-variant">New status</label>
                    <select asp-for="NewStatus" class="analog-input">
                        @foreach (PackageStatus status in Enum.GetValues(typeof(PackageStatus)))
                        {
                            <option value="@status">@status</option>
                        }
                    </select>
                </div>
            </div>

            <div class="field-error mt-3" data-edit-summary></div>

            <div class="mt-6 flex items-center justify-end gap-3">
                <button type="button" class="rounded px-3 py-2 text-[10px] font-label uppercase tracking-widest text-on-surface-variant hover:text-on-surface" data-edit-close>
                    Cancel
                </button>
                <button type="submit" class="inline-flex items-center gap-2 rounded px-4 py-2 text-[10px] font-label uppercase tracking-widest text-on-secondary-container bg-secondary-container hover:bg-secondary-container/80">
                    <span class="material-symbols-outlined text-[16px]">edit</span>
                    Save status log
                </button>
            </div>
        </form>
    </div>
</div>

