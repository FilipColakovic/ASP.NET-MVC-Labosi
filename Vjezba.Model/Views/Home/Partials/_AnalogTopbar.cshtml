<header class="w-full sticky top-0 analog-topbar-surface backdrop-blur z-10">
    <div class="px-4 md:px-6 py-4 flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div class="flex items-center gap-6">
            <span class="font-headline font-extrabold tracking-widest text-lg md:text-xl text-[#7a4c2b] uppercase">Package Hub</span>
            <nav class="hidden md:flex space-x-6">
                <a class="text-[#7a4c2b] border-b-2 border-[#7a4c2b] font-label text-xs uppercase tracking-widest py-1" href="#">Overview</a>
                <a class="text-[#1f1d1b] hover:bg-[#e5e2df] transition-colors font-label text-xs uppercase tracking-widest py-1" href="#manifest">Manifests</a>
                <a class="text-[#1f1d1b] hover:bg-[#e5e2df] transition-colors font-label text-xs uppercase tracking-widest py-1" href="#insights">Analytics</a>
            </nav>
        </div>

        <div class="flex items-center space-x-3">
            <div class="hidden sm:flex items-center analog-search-shell rounded-lg px-3 py-2 w-56 md:w-64">
                <span class="material-symbols-outlined text-stone-500 text-sm">search</span>
                <input id="analog-manifest-search"
                       data-role="manifest-search"
                       class="bg-transparent border-none focus:ring-0 text-xs font-label uppercase tracking-wider w-full placeholder:text-stone-400"
                       placeholder="Search manifest..."
                       type="text"
                       autocomplete="off"
                       spellcheck="false"
                       aria-label="Search manifest rows" />
            </div>
            <button class="p-2 text-stone-600 hover:bg-[#e5e2df] rounded-full transition-colors" type="button">
                <span class="material-symbols-outlined">notifications</span>
            </button>
            <button class="p-2 text-stone-600 hover:bg-[#e5e2df] rounded-full transition-colors" type="button">
                <span class="material-symbols-outlined">settings</span>
            </button>
            <div class="w-8 h-8 rounded-full border border-outline-variant/20 bg-primary-container"></div>
        </div>
    </div>
</header>

<script>
    (() => {
        const initManifestSearch = () => {
            const searchInput = document.getElementById("analog-manifest-search");
            if (!searchInput) return;

            const manifest = document.getElementById("manifest");
            const tbody = manifest ? manifest.querySelector("tbody") : null;
            const thead = manifest ? manifest.querySelector("thead tr") : null;

            if (!tbody) {
                searchInput.disabled = true;
                searchInput.placeholder = "No manifest to search";
                return;
            }

            const normalize = (value) => (value || "").toString().toUpperCase().replace(/[^A-Z0-9]/g, "");
            const isSubsequence = (needle, haystack) => {
                if (!needle) return true;
                let index = 0;
                for (let i = 0; i < haystack.length && index < needle.length; i++) {
                    if (haystack[i] === needle[index]) index++;
                }
                return index === needle.length;
            };

            const fuzzyMatch = (query, candidate) => {
                if (!query) return true;
                if (candidate.includes(query)) return true;
                return isSubsequence(query, candidate);
            };

            let noResultsRow = document.getElementById("manifest-search-empty");
            if (!noResultsRow) {
                noResultsRow = document.createElement("tr");
                noResultsRow.id = "manifest-search-empty";
                noResultsRow.style.display = "none";

                const cell = document.createElement("td");
                cell.colSpan = thead ? thead.querySelectorAll("th").length : 5;
                cell.className = "px-6 py-8 text-center text-on-surface-variant font-label text-xs uppercase tracking-widest";
                cell.textContent = "No rows match your search.";

                noResultsRow.appendChild(cell);
                tbody.appendChild(noResultsRow);
            }

            const getRows = () =>
                Array.from(tbody.querySelectorAll("tr")).filter((row) => row.id !== "manifest-search-empty");

            const applyFilter = () => {
                const query = normalize(searchInput.value);
                const rows = getRows();
                let visibleCount = 0;

                rows.forEach((row) => {
                    const rowText = normalize(row.textContent || "");
                    const matched = fuzzyMatch(query, rowText);
                    row.style.display = matched ? "" : "none";
                    if (matched) visibleCount++;
                });

                noResultsRow.style.display = visibleCount === 0 ? "" : "none";
            };

            searchInput.addEventListener("input", applyFilter);
            applyFilter();
        };

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", initManifestSearch, { once: true });
            return;
        }

        initManifestSearch();
    })();
</script>
