@{
    var selectedType = (ViewData["SelectedType"]?.ToString() ?? "package").Trim().ToLowerInvariant();
    var topbarActive = (ViewData["TopbarActive"]?.ToString() ?? "track").Trim().ToLowerInvariant();
    var searchPlaceholder = ViewData["TopbarSearchPlaceholder"]?.ToString() ?? "Search package...";
    var isManifestTopbar = topbarActive == "manifest";
    var isAuthenticated = User?.Identity?.IsAuthenticated ?? false;
    var isAdmin = User?.IsInRole("Admin") ?? false;
    var isManager = User?.IsInRole("Manager") ?? false;
    var canAccessStaffPages = isAdmin || isManager;
    var userDisplayName = User?.Identity?.Name ?? "Account";
    var logoutReturnUrl = Url.Content("~/");
    var manifestSelectedType = selectedType switch
    {
        "package" => "package",
        "courier" => "courier",
        "warehouse" => "warehouse",
        "user" => "user",
        "delivery" => "delivery",
        "address" => "address",
        "statuslog" => "statuslog",
        _ => "package"
    };
}

<header class="w-full sticky top-0 z-30 border-b border-[#d8d3ce] bg-[#ece9e6]/95 backdrop-blur-md">
    <div class="px-4 md:px-6 xl:px-8 py-3 sm:py-4 flex items-center gap-3 lg:gap-5">
        <button type="button"
                class="inline-flex lg:hidden h-10 w-10 shrink-0 items-center justify-center rounded-full border border-[#d3cdc6] bg-[#e7e3df] text-[#6a5e53] hover:text-[#7a4c2b] hover:border-[#c0b8b0] transition-colors"
                data-analog-menu-open
                aria-controls="analog-mobile-menu"
                aria-expanded="false"
                aria-label="Open menu">
            <span class="material-symbols-outlined">menu</span>
        </button>

        <a asp-action="Index"
           asp-controller="Home"
           class="font-headline font-extrabold tracking-[0.12em] text-base sm:text-lg lg:text-2xl xl:text-3xl text-[#7a4c2b] uppercase whitespace-nowrap shrink-0">
            Package Hub
        </a>

        <nav class="hidden lg:flex items-center gap-4 lg:gap-6 xl:gap-7 min-w-0 flex-1 overflow-hidden">
            <a asp-action="Index"
               asp-controller="Home"
               class="font-label text-[12px] lg:text-[13px] uppercase tracking-[0.14em] pb-1 whitespace-nowrap transition-colors @(topbarActive == "track" ? "text-[#7a4c2b] border-b-2 border-[#7a4c2b]" : "text-[#1f1d1b] hover:text-[#7a4c2b]")">
                Track
            </a>
            @if (canAccessStaffPages)
            {
                <a asp-action="Manifest"
                   asp-controller="Home"
                   asp-route-selectedType="@manifestSelectedType"
                   class="font-label text-[12px] lg:text-[13px] uppercase tracking-[0.14em] pb-1 whitespace-nowrap transition-colors @(topbarActive == "manifest" ? "text-[#7a4c2b] border-b-2 border-[#7a4c2b]" : "text-[#1f1d1b] hover:text-[#7a4c2b]")">
                    Manifests
                </a>
                <a asp-action="Analytics"
                   asp-controller="Home"
                   class="font-label text-[12px] lg:text-[13px] uppercase tracking-[0.14em] pb-1 whitespace-nowrap transition-colors @(topbarActive == "analytics" ? "text-[#7a4c2b] border-b-2 border-[#7a4c2b]" : "text-[#1f1d1b] hover:text-[#7a4c2b]")">
                    Analytics
                </a>
                @if (isAdmin)
                {
                    <a asp-action="Index"
                       asp-controller="AdminUsers"
                       class="font-label text-[12px] lg:text-[13px] uppercase tracking-[0.14em] pb-1 whitespace-nowrap transition-colors @(topbarActive == "admin" ? "text-[#7a4c2b] border-b-2 border-[#7a4c2b]" : "text-[#1f1d1b] hover:text-[#7a4c2b]")">
                        Users
                    </a>
                }
            }
        </nav>

        <div class="ml-auto flex items-center gap-1 sm:gap-2 lg:gap-3 xl:gap-4 shrink-0">
            <div class="hidden lg:flex items-center gap-2 rounded-xl border border-[#cdc7c1] bg-[#d8d3ce]/65 px-3 py-2 w-56 xl:w-72">
                <span class="material-symbols-outlined text-[#73695f] text-[18px]">search</span>
                <input id="@(isManifestTopbar ? "analog-manifest-search" : "analog-global-search")"
                       class="w-full min-w-0 bg-transparent border-none p-0 focus:ring-0 font-label text-xs uppercase tracking-[0.08em] text-[#5f554b] placeholder:text-[#8f857b]"
                       placeholder="@searchPlaceholder"
                       type="text"
                       autocomplete="off"
                       spellcheck="false"
                       aria-label="@searchPlaceholder" />
            </div>
            <button class="p-2 text-[#6a5e53] hover:text-[#7a4c2b] transition-colors rounded-full" type="button" aria-label="Notifications">
                <span class="material-symbols-outlined">notifications</span>
            </button>
            <button class="p-2 text-[#6a5e53] hover:text-[#7a4c2b] transition-colors rounded-full" type="button" aria-label="Settings">
                <span class="material-symbols-outlined">settings</span>
            </button>
            @if (isAuthenticated)
            {
                @if (canAccessStaffPages)
                {
                    <a asp-area="Identity"
                       asp-page="/Account/Manage/Index"
                       title="@userDisplayName"
                       class="hidden sm:inline-flex h-10 w-10 items-center justify-center rounded-full border border-[#d3cdc6] bg-[#e7e3df] text-[#6a5e53] hover:text-[#7a4c2b] hover:border-[#c0b8b0] transition-colors"
                       aria-label="Account">
                        <span class="material-symbols-outlined">person</span>
                    </a>
                }
                <form asp-area="Identity"
                      asp-page="/Account/Logout"
                      asp-route-returnUrl="@logoutReturnUrl"
                      method="post"
                      class="hidden sm:inline-flex">
                    <button type="submit"
                            title="Log out"
                            class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-[#d3cdc6] bg-[#e7e3df] text-[#6a5e53] hover:text-[#7a4c2b] hover:border-[#c0b8b0] transition-colors"
                            aria-label="Log out">
                        <span class="material-symbols-outlined">logout</span>
                    </button>
                </form>
            }
            else
            {
                <button type="button"
                   data-login-open
                   class="hidden sm:inline-flex items-center gap-1 rounded-full border border-[#d3cdc6] bg-[#e7e3df] px-3 py-2 text-[#6a5e53] hover:text-[#7a4c2b] hover:border-[#c0b8b0] transition-colors"
                   aria-label="Login">
                    <span class="material-symbols-outlined text-[18px]">person</span>
                    <span class="font-label text-[10px] uppercase tracking-[0.12em]">Login</span>
                </button>
            }
        </div>
    </div>
</header>

<div id="analog-mobile-menu"
     class="analog-mobile-menu"
     data-analog-mobile-menu
     aria-hidden="true">
    <button type="button"
            class="analog-mobile-menu-backdrop"
            data-analog-menu-close
            aria-label="Close menu"></button>
    <aside class="analog-mobile-menu-panel"
           role="dialog"
           aria-modal="true"
           aria-labelledby="analog-mobile-menu-title">
        <div class="mb-6 flex items-start justify-between gap-4">
            <div>
                <p class="font-label text-[10px] uppercase tracking-[0.28em] text-[#7a4c2b]">Navigation</p>
                <h2 id="analog-mobile-menu-title" class="mt-1 font-headline text-2xl font-extrabold text-[#3d2b1b]">Package Hub</h2>
            </div>
            <button type="button"
                    class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-[#d3cdc6] bg-[#e7e3df] text-[#6a5e53]"
                    data-analog-menu-close
                    aria-label="Close menu">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>

        <nav class="space-y-2">
            <a asp-action="Index"
               asp-controller="Home"
               class="analog-mobile-menu-link @(topbarActive == "track" ? "is-active" : "")">
                <span class="material-symbols-outlined">search</span>
                <span>Track</span>
            </a>
            @if (canAccessStaffPages)
            {
                <a asp-action="Manifest"
                   asp-controller="Home"
                   asp-route-selectedType="@manifestSelectedType"
                   class="analog-mobile-menu-link @(topbarActive == "manifest" ? "is-active" : "")">
                    <span class="material-symbols-outlined">inventory_2</span>
                    <span>Manifests</span>
                </a>
                <a asp-action="Analytics"
                   asp-controller="Home"
                   class="analog-mobile-menu-link @(topbarActive == "analytics" ? "is-active" : "")">
                    <span class="material-symbols-outlined">analytics</span>
                    <span>Analytics</span>
                </a>
                @if (isAdmin)
                {
                    <a asp-action="Index"
                       asp-controller="AdminUsers"
                       class="analog-mobile-menu-link @(topbarActive == "admin" ? "is-active" : "")">
                        <span class="material-symbols-outlined">admin_panel_settings</span>
                        <span>Users</span>
                    </a>
                }
            }
            <a asp-action="Privacy"
               asp-controller="Home"
               class="analog-mobile-menu-link @(topbarActive == "privacy" ? "is-active" : "")">
                <span class="material-symbols-outlined">privacy_tip</span>
                <span>Privacy</span>
            </a>
        </nav>

        <div class="mt-6 border-t border-[#d8d3ce] pt-5">
            @if (isAuthenticated)
            {
                <a asp-area="Identity"
                   asp-page="/Account/Manage/Index"
                   class="analog-mobile-menu-link">
                    <span class="material-symbols-outlined">person</span>
                    <span>Account</span>
                </a>
                <form asp-area="Identity"
                      asp-page="/Account/Logout"
                      asp-route-returnUrl="@logoutReturnUrl"
                      method="post"
                      class="mt-2">
                    <button type="submit" class="analog-mobile-menu-link w-full">
                        <span class="material-symbols-outlined">logout</span>
                        <span>Log out</span>
                    </button>
                </form>
            }
            else
            {
                <button type="button"
                        data-login-open
                        data-analog-menu-close
                        class="analog-mobile-menu-link w-full">
                    <span class="material-symbols-outlined">person</span>
                    <span>Login</span>
                </button>
            }
        </div>
    </aside>
</div>

<script>
    (() => {
        const menu = document.querySelector("[data-analog-mobile-menu]");
        const openButton = document.querySelector("[data-analog-menu-open]");
        if (!menu || !openButton || menu.dataset.initialized === "true") return;

        menu.dataset.initialized = "true";
        const closeButtons = menu.querySelectorAll("[data-analog-menu-close]");
        const focusableSelector = "a[href], button:not([disabled]), input, select, textarea, [tabindex]:not([tabindex='-1'])";
        let previousFocus = null;

        const setOpen = (isOpen) => {
            menu.classList.toggle("is-open", isOpen);
            menu.setAttribute("aria-hidden", isOpen ? "false" : "true");
            openButton.setAttribute("aria-expanded", isOpen ? "true" : "false");
            document.documentElement.classList.toggle("analog-menu-open", isOpen);

            if (isOpen) {
                previousFocus = document.activeElement;
                window.setTimeout(() => {
                    const firstFocusable = menu.querySelector(focusableSelector);
                    firstFocusable?.focus();
                }, 40);
            } else if (previousFocus && typeof previousFocus.focus === "function") {
                previousFocus.focus();
            }
        };

        openButton.addEventListener("click", () => setOpen(true));
        closeButtons.forEach((button) => button.addEventListener("click", () => setOpen(false)));
        menu.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => setOpen(false)));
        document.addEventListener("keydown", (event) => {
            if (event.key === "Escape" && menu.classList.contains("is-open")) {
                setOpen(false);
            }
        });
    })();
</script>

@if (!isAuthenticated)
{
    <partial name="~/Views/Home/Partials/_AnalogLoginPopup.cshtml" />
}

@if (isManifestTopbar)
{
    <script>
        (() => {
            const initManifestSearch = () => {
                const searchInput = document.getElementById("analog-manifest-search");
                if (!searchInput) return;

                const manifest = document.getElementById("manifest");
                const table = manifest ? manifest.querySelector("table[data-selected-type]") : null;
                const tbody = table ? table.querySelector("tbody") : null;
                const thead = table ? table.querySelector("thead tr") : null;
                const selectedType = table ? table.getAttribute("data-selected-type") : "";
                const typeLabels = {
                    package: "package",
                    courier: "courier",
                    warehouse: "warehouse",
                    user: "user",
                    delivery: "delivery",
                    address: "address",
                    statuslog: "status log"
                };
                const selectedTypeLabel = typeLabels[(selectedType || "").toLowerCase()] || "item";

                searchInput.placeholder = `Search ${selectedTypeLabel}...`;
                searchInput.setAttribute("aria-label", `Search ${selectedTypeLabel} rows`);

                if (!tbody || !selectedType) {
                    return;
                }

                const normalize = (value) => (value || "").toString().toUpperCase().replace(/[^A-Z0-9]/g, "");
                const isSubsequence = (needle, haystack) => {
                    if (!needle) return true;
                    let index = 0;
                    for (let i = 0; i < haystack.length && index < needle.length; i++) {
                        if (haystack[i] === needle[index]) index++;
                    }
                    return index === needle.length;
                };

                const fuzzyMatch = (query, candidate) => {
                    if (!query) return true;
                    if (candidate.includes(query)) return true;
                    return isSubsequence(query, candidate);
                };

                const applyClientFallback = (query) => {
                    const rows = getRows();
                    let visibleCount = 0;

                    rows.forEach((row) => {
                        const rowText = normalize(row.textContent || "");
                        const matched = fuzzyMatch(query, rowText);
                        row.style.display = matched ? "" : "none";
                        if (matched) visibleCount++;
                    });

                    noResultsRow.style.display = visibleCount === 0 ? "" : "none";
                };

                let noResultsRow = document.getElementById("manifest-search-empty");
                if (!noResultsRow) {
                    noResultsRow = document.createElement("tr");
                    noResultsRow.id = "manifest-search-empty";
                    noResultsRow.style.display = "none";

                    const cell = document.createElement("td");
                    cell.colSpan = thead ? thead.querySelectorAll("th").length : 5;
                    cell.className = "px-6 py-8 text-center text-on-surface-variant font-label text-xs uppercase tracking-widest";
                    cell.textContent = "No rows match your search.";

                    noResultsRow.appendChild(cell);
                    tbody.appendChild(noResultsRow);
                }

                const getRows = () =>
                    Array.from(tbody.querySelectorAll("tr[data-row-id]"));

                const applyVisibilityFromIds = (ids) => {
                    const rows = getRows();
                    const visibleIdSet = new Set(ids.map((id) => id.toString()));
                    let visibleCount = 0;

                    rows.forEach((row) => {
                        const rowId = row.getAttribute("data-row-id") || "";
                        const matched = visibleIdSet.has(rowId);
                        row.style.display = matched ? "" : "none";
                        if (matched) visibleCount++;
                    });

                    noResultsRow.style.display = visibleCount === 0 ? "" : "none";
                };

                let debounceHandle = 0;
                let latestRequestId = 0;

                const applyFilter = () => {
                    window.clearTimeout(debounceHandle);
                    debounceHandle = window.setTimeout(async () => {
                        const requestId = ++latestRequestId;
                        const query = searchInput.value || "";
                        const normalizedQuery = normalize(query);

                        try {
                            const url = `/manifest/search?selectedType=${encodeURIComponent(selectedType)}&q=${encodeURIComponent(query)}`;
                            const response = await fetch(url, {
                                headers: {
                                    "X-Requested-With": "XMLHttpRequest"
                                }
                            });

                            if (!response.ok) {
                                throw new Error("Manifest search failed.");
                            }

                            const payload = await response.json();
                            if (requestId !== latestRequestId) {
                                return;
                            }

                            const ids = payload && Array.isArray(payload.ids) ? payload.ids : [];
                            applyVisibilityFromIds(ids);
                        } catch (error) {
                            // Fallback to client filtering if AJAX search is unavailable.
                            applyClientFallback(normalizedQuery);
                        }
                    }, 180);
                };

                searchInput.addEventListener("input", applyFilter);
                applyFilter();
            };

            if (document.readyState === "loading") {
                document.addEventListener("DOMContentLoaded", initManifestSearch, { once: true });
                return;
            }

            initManifestSearch();
        })();
    </script>
}
