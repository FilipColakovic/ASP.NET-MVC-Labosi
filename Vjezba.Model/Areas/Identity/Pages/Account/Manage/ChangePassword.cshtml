@page
@model Vjezba.Model.Areas.Identity.Pages.Account.Manage.ChangePasswordModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Password Control";
    ViewData["ManageNavActive"] = "password";
    ViewData["ManageEyebrow"] = "Access Cipher";
    ViewData["ManageDescription"] = "Rotate your local password and keep the terminal credential chain current.";
}

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="mb-6 rounded-2xl border border-green-700/20 bg-green-100/80 px-5 py-4 font-label text-xs uppercase tracking-widest text-green-900">@Model.StatusMessage</div>
}

<section class="details-content-shell relative overflow-hidden rounded-3xl p-6 shadow-[0_18px_55px_rgba(67,45,30,0.08)] md:p-8">
    <div class="absolute -right-16 -top-20 h-56 w-56 rounded-full bg-secondary/15 blur-3xl"></div>
    <div class="relative mb-8 flex items-start justify-between gap-4">
        <div>
            <h2 class="font-headline text-2xl font-extrabold tracking-tight">Password Rotation</h2>
            <p class="mt-1 font-label text-[10px] uppercase tracking-[0.22em] text-outline">Section ID: AUTH-K-511</p>
        </div>
        <span class="material-symbols-outlined text-5xl text-primary/25">key</span>
    </div>

    @if (!Model.HasPassword)
    {
        <div class="rounded-2xl border border-outline-variant/35 bg-surface-container-low/75 p-5">
            <p class="font-label text-xs uppercase tracking-widest text-on-surface-variant">This account currently signs in through an external provider and does not have a local password.</p>
        </div>
    }
    else
    {
        <form method="post" class="relative grid gap-6 lg:grid-cols-3">
            <div asp-validation-summary="ModelOnly" class="rounded-2xl border border-red-700/20 bg-red-100/80 px-4 py-3 text-sm text-red-900 lg:col-span-3"></div>

            <div>
                <label asp-for="Input.OldPassword" class="mb-2 block font-label text-[10px] font-bold uppercase tracking-[0.22em] text-outline">Current Cipher</label>
                <input asp-for="Input.OldPassword" class="analog-input manage-rounded-input" autocomplete="current-password" placeholder="Current password" />
                <span asp-validation-for="Input.OldPassword" class="field-error"></span>
            </div>
            <div>
                <label asp-for="Input.NewPassword" class="mb-2 block font-label text-[10px] font-bold uppercase tracking-[0.22em] text-primary">New Cipher</label>
                <input asp-for="Input.NewPassword" class="analog-input manage-rounded-input" autocomplete="new-password" placeholder="New password" />
                <span asp-validation-for="Input.NewPassword" class="field-error"></span>
            </div>
            <div>
                <label asp-for="Input.ConfirmPassword" class="mb-2 block font-label text-[10px] font-bold uppercase tracking-[0.22em] text-primary">Confirm Cipher</label>
                <input asp-for="Input.ConfirmPassword" class="analog-input manage-rounded-input" autocomplete="new-password" placeholder="Confirm password" />
                <span asp-validation-for="Input.ConfirmPassword" class="field-error"></span>
            </div>

            <div class="lg:col-span-3">
                <button type="submit" class="inline-flex w-full items-center justify-center gap-3 rounded-2xl bg-primary px-8 py-4 font-label text-xs font-bold uppercase tracking-[0.24em] text-on-primary transition-colors hover:bg-surface-tint md:w-auto">
                    Save Password
                    <span class="material-symbols-outlined text-lg">lock_reset</span>
                </button>
            </div>
        </form>
    }
</section>
