@page
@model Vjezba.Model.Areas.Identity.Pages.Account.Manage.TwoFactorAuthenticationModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "2FA Secure";
    ViewData["ManageNavActive"] = "2fa";
    ViewData["ManageEyebrow"] = "Security Layer";
    ViewData["ManageDescription"] = "Inspect and control the additional authentication layer for this local terminal account.";
}

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="mb-6 rounded-2xl border border-green-700/20 bg-green-100/80 px-5 py-4 font-label text-xs uppercase tracking-widest text-green-900">@Model.StatusMessage</div>
}

<div class="grid grid-cols-1 gap-6 xl:grid-cols-3">
    <section class="details-content-shell relative overflow-hidden rounded-3xl p-6 shadow-[0_18px_55px_rgba(67,45,30,0.08)] md:p-8 xl:col-span-2">
        <div class="absolute -right-16 -top-20 h-56 w-56 rounded-full bg-secondary/15 blur-3xl"></div>
        <div class="relative mb-8 flex items-start justify-between gap-4">
            <div>
                <h2 class="font-headline text-2xl font-extrabold tracking-tight">Two-Factor Authentication</h2>
                <p class="mt-1 font-label text-[10px] uppercase tracking-[0.22em] text-outline">Section ID: AUTH-S-204</p>
            </div>
            <span class="material-symbols-outlined text-5xl text-primary/25">shield</span>
        </div>

        <div class="relative grid gap-4 md:grid-cols-3">
            <div class="rounded-2xl border border-outline-variant/30 bg-surface-container-low/70 p-5">
                <p class="font-label text-[10px] uppercase tracking-[0.22em] text-outline">2FA State</p>
                <p class="mt-3 font-headline text-2xl font-extrabold @(Model.Is2faEnabled ? "text-green-800" : "text-red-900")">@(Model.Is2faEnabled ? "Enabled" : "Disabled")</p>
            </div>
            <div class="rounded-2xl border border-outline-variant/30 bg-surface-container-low/70 p-5">
                <p class="font-label text-[10px] uppercase tracking-[0.22em] text-outline">Browser Memory</p>
                <p class="mt-3 font-headline text-2xl font-extrabold">@(Model.IsMachineRemembered ? "Trusted" : "Fresh")</p>
            </div>
            <div class="rounded-2xl border border-outline-variant/30 bg-surface-container-low/70 p-5">
                <p class="font-label text-[10px] uppercase tracking-[0.22em] text-outline">Recovery Codes</p>
                <p class="mt-3 font-headline text-2xl font-extrabold">@Model.RecoveryCodesLeft</p>
            </div>
        </div>

        <div class="relative mt-8 flex flex-wrap gap-3">
            @if (Model.Is2faEnabled)
            {
                <form method="post" asp-page-handler="Disable">
                    <button type="submit" class="inline-flex items-center justify-center gap-3 rounded-2xl border border-red-800/20 px-6 py-4 font-label text-xs font-bold uppercase tracking-[0.2em] text-red-900 transition-colors hover:bg-red-100">
                        Disable 2FA
                        <span class="material-symbols-outlined text-lg">shield_lock</span>
                    </button>
                </form>
            }
            else
            {
                <form method="post" asp-page-handler="Enable">
                    <button type="submit" class="inline-flex items-center justify-center gap-3 rounded-2xl bg-primary px-6 py-4 font-label text-xs font-bold uppercase tracking-[0.2em] text-on-primary transition-colors hover:bg-surface-tint">
                        Enable 2FA
                        <span class="material-symbols-outlined text-lg">shield</span>
                    </button>
                </form>
            }

            <form method="post" asp-page-handler="ForgetBrowser">
                <button type="submit" class="inline-flex items-center justify-center gap-3 rounded-2xl border border-outline-variant/45 px-6 py-4 font-label text-xs font-bold uppercase tracking-[0.2em] text-primary transition-colors hover:bg-surface-container-high">
                    Forget Browser
                    <span class="material-symbols-outlined text-lg">devices_off</span>
                </button>
            </form>
        </div>
    </section>

    <aside class="rounded-3xl border border-secondary-container/25 bg-secondary-container/10 p-6 paper-grain shadow-[0_12px_30px_rgba(67,45,30,0.05)]">
        <span class="material-symbols-outlined mb-4 text-5xl text-secondary" style="font-variation-settings: 'FILL' 1;">verified_user</span>
        <h3 class="font-headline text-lg font-bold text-secondary">Security Note</h3>
        <p class="mt-3 font-label text-[10px] uppercase leading-5 tracking-widest text-on-surface-variant">
            This page controls the Identity 2FA flag. A full authenticator-app enrollment screen can be added later if your lab requires QR-code setup.
        </p>
    </aside>
</div>
