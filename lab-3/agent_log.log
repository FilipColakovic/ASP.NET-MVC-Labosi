        {
          "pattern": "^Agent output:\\s.*$",
          "foreground": "#7bd389",
          "fontWeight": "bold"
        },
        {
          "pattern": "^Validation:\\s*$",
          "foreground": "#f4a261",
          "fontWeight": "bold"
        },
        {
          "pattern": "^Current output path is:\\s*$",
          "foreground": "#cdb4db",
          "fontWeight": "bold"
        },
        {
          "pattern": "^\\s*-\\s.*passed.*$",
          "patternFlags": "i",
          "foreground": "#7bd389"
        },
        {
          "pattern": "^\\s*-\\s.*(fail|failed|error|exception).*$",
          "patternFlags": "i",
