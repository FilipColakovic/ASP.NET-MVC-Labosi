          "pattern": "^Timestamp:\\s.*$",
          "foreground": "#6ad1ff",
          "fontWeight": "bold"
        },
        {
          "pattern": "^Agent:\\s.*$",
          "foreground": "#ffd166",
          "fontWeight": "bold"
        },
        {
          "pattern": "^User Input:\\s.*$",
          "foreground": "#a0e7e5",
          "fontWeight": "bold"
