{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build Vjezba.Model",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/Vjezba.Model/Vjezba.Model.csproj"
            ],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Sync Log Highlighter Patterns",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/.vscode/sync-log-highlighter-patterns.ps1"
            ],
            "problemMatcher": []
        }
    ]
}
